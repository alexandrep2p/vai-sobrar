meta {
  name: Criar categoria de entrada
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Salario {{runId}}",
    "type": "INCOME"
  }
}

vars:post-response {
  incomeCategoryId: res.body.id
}

assert {
  res.status: eq 201
}
