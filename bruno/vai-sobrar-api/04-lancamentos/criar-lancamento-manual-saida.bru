meta {
  name: Criar lancamento manual (saida)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

body:json {
  {
    "description": "Aluguel",
    "amount": 150000,
    "due_date": "{{dueDate}}",
    "category_id": "{{categoryId}}",
    "payment_method_id": "{{pixId}}",
    "type": "EXPENSE"
  }
}

vars:post-response {
  transactionId: res.body.id
}

assert {
  res.status: eq 201
}

docs {
  amount em centavos (150000 = R$ 1.500,00). Retroativo só dentro do mês corrente.
}
