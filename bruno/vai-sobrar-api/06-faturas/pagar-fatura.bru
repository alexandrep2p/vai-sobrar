meta {
  name: Pagar fatura
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/invoices/{{invoiceId}}/pay
  body: json
  auth: none
}

body:json {
  {
    "paid_at": "{{today}}",
    "payment_method_id": "{{pixId}}"
  }
}

docs {
  Paga fatura OPEN ou CLOSED (PD-32); fatura PAID retorna INVOICE_ALREADY_PAID. O pagamento é irreversível.
}
