meta {
  name: Cadastrar conta
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Usuario Bruno",
    "username": "bruno-{{runId}}",
    "email": "bruno-{{runId}}@vaisobrar.test",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  Cria a conta (com PIX, Dinheiro e Débito) sem abrir sessão. Senha de teste definida em `password` (collection).
}
