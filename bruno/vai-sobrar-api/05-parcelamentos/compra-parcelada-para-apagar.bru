meta {
  name: Compra parcelada para apagar
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

body:json {
  {
    "description": "Compra lancada errada",
    "amount": 12000,
    "purchase_date": "{{today}}",
    "category_id": "{{categoryId}}",
    "payment_method_id": "{{cardMethodId}}",
    "installment_count": 2
  }
}

vars:post-response {
  planToDeleteId: res.body.installment_plan.id
}

assert {
  res.status: eq 201
}

docs {
  Compra própria para a requisição seguinte ("Apagar compra parcelada"), para não apagar a compra usada pelos estornos (pasta 07).
}
