meta {
  name: Criar recorrencia (sem termino)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/recurrences
  body: json
  auth: none
}

body:json {
  {
    "description": "Internet",
    "amount": 12000,
    "category_id": "{{categoryId}}",
    "payment_method_id": "{{pixId}}",
    "due_day": 10,
    "start_date": "{{today}}"
  }
}

vars:post-response {
  recurrenceId: res.body.id
}

assert {
  res.status: eq 201
}

docs {
  Não há ocorrência anterior à data de criação. Dias 29/30/31 usam o último dia do mês.
}
